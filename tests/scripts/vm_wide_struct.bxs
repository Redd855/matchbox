// Public dictionary behavior and memory fixture, independent of bx-lint.
function wideStructCheck() {
    var data = {}; var i = 0;
    for (i = 0; i < 11293; i++) { data[toString(i)] = i; }
    assert len(data) == 11293;
    assert data["0"] == 0 && data["11292"] == 11292;
    data.last = "é中😀"; assert data["LAST"] == "é中😀";
    assert structKeyArray(data).len() == 11294;
    var ordered = structNew("ordered");
    for (i = 0; i < 200; i++) { ordered["key" & i] = i; }
    assert structDelete(ordered, "key10");
    var keys = structKeyArray(ordered);
    assert keys[10] == "key9" && keys[11] == "key11" && keys[199] == "key199";
    var copied = duplicate(ordered); copied.key199 = -1; assert ordered.key199 == 199;
    assert structDelete(copied, "key0") && structKeyExists(ordered, "key0");
    structClear(copied); copied.fresh = 7;
    assert len(copied) == 1 && copied.fresh == 7 && !structKeyExists(copied, "key199");
    var sensitive = structNew("caseSensitive"); sensitive.Name = 1; sensitive.name = 2;
    assert len(sensitive) == 2 && sensitive.Name == 1 && sensitive.name == 2;
    assert sensitive["Name"] == 1 && sensitive["name"] == 2;
    var sensitiveCopy = duplicate(sensitive); sensitiveCopy.Name = 9; assert sensitive.Name == 1;
    assert structDelete(sensitive, "Name") && sensitive.name == 2 && !structKeyExists(sensitive, "Name");
    var observed = 0; for (key, value in ordered) { assert value == ordered[key]; observed += 1; }
    assert observed == 199;
    var decoded = jsonDeserialize(jsonSerialize(data));
    assert decoded["11292"] == 11292 && decoded.LAST == "é中😀";
    // Existing constant-member cache sites must continue to work across different layouts.
    var left = {value: 1}; var right = {other: 0, value: 10};
    for (i = 0; i < 200; i++) { assert readValue(left) == 1 && readValue(right) == 10; }
    left.extra = 2; assert readValue(left) == 1;
    structDelete(left, "extra"); assert readValue(left) == 1;
    structClear(left); left.value = 3; assert readValue(left) == 3;
    var garbage = {};
    for (i = 0; i < 100000; i++) { garbage = {value: i}; }
    assert data["11292"] == 11292 && data.LAST == "é中😀" && sensitiveCopy.Name == 9;
    println("Wide struct checks passed");
    sleep(1500);
}
function readValue(data) { return data.value; }
wideStructCheck();
